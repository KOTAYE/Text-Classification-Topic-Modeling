# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# The agent uses OpenAI when OPENAI_API_KEY is set, and falls back to Groq
# otherwise. Set one of the two.

# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Free tier: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to qwen/qwen3.6-27b.
# llama-3.1-8b-instant is faster but sometimes emits malformed tool calls.
GROQ_MODEL=qwen/qwen3.6-27b

# Telegram, reached over MCP. Without these the agent starts without the
# Telegram tools rather than failing.
#
# Token: talk to @BotFather -> /newbot. If it ever leaks, /revoke issues a new
# one and kills the old.
# Chat id: message your bot, then run scripts/telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
